---
import Layout from '../layouts/Layout.astro';
import { games, iconUrl, isNew, playUrl, type Game, type Lang } from '../data/games';
import { categoryLabel, fill, routes, t } from '../i18n/ui';
import { descriptionSections } from '../lib/description';
import { gameJsonLd } from '../lib/jsonld';
import { showDownloads } from '../lib/format';

interface Props {
  lang: Lang;
  game: Game;
}

const { lang, game } = Astro.props;
const s = t(lang);
const title = game.title[lang];
const { intro, sections } = descriptionSections(game, lang);
const related = games.filter((g) => g.category === game.category && g.slug !== game.slug).slice(0, 3);
const released = new Date(game.released).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', {
  year: 'numeric',
  month: 'long',
});
const home = routes.home(lang);
---

<Layout
  lang={lang}
  title={fill(s.game.metaTitle, { title })}
  description={game.short[lang]}
  alternates={{ es: routes.game('es', game), en: routes.game('en', game) }}
  ogImage={{ src: iconUrl(game), width: 512, height: 512, alt: title }}
  jsonLd={gameJsonLd(game, lang)}
>
  <main>
    <!-- HEAD -->
    <section class="container head-wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`${home}#games`}>{s.game.breadcrumbGames}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <div class="head">
        <img class="head-icon" src={iconUrl(game)} alt="" width="512" height="512" fetchpriority="high" />
        <div class="head-copy">
          <div class="chips">
            <span class="chip chip-lime">{categoryLabel[game.category][lang]}</span>
            {isNew(game) && <span class="chip">{s.catalog.newBadge}</span>}
            {showDownloads(game) && <span class="chip">{game.downloads} {s.game.downloads}</span>}
            {game.rating && (
              <span class="chip">{game.rating.value.toLocaleString(lang)}★ · {game.rating.count.toLocaleString(lang)} {s.game.ratings}</span>
            )}
            <span class="chip">{s.game.released} {released}</span>
          </div>
          <h1 class="display head-title">{title}</h1>
          <p class="head-short muted">{game.short[lang]}</p>
        </div>
        <div class="head-cta">
          <a class="btn btn-primary btn-big" href={playUrl(game)} target="_blank" rel="noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3.5v17c0 .6.7 1 1.2.7l14.6-8.5c.5-.3.5-1.1 0-1.4L6.2 2.8C5.7 2.5 5 2.9 5 3.5z" /></svg>
            {s.game.download}
          </a>
          <span class="muted head-note">{s.game.freeNote}</span>
        </div>
      </div>
    </section>

    <!-- SHOTS -->
    <section class="shots-band" aria-label={s.game.screenshots}>
      <div class="container">
        <div class="shots" tabindex="0" aria-label={fill(s.game.shotsHint, { title })}>
          {game.shots.map((shot, i) => (
            <img
              src={shot.src}
              width={shot.width}
              height={shot.height}
              alt={fill(s.game.screenshotAlt, { n: i + 1, title })}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- DESCRIPTION -->
    <section class="container about">
      <div class="about-intro">
        <h2 class="display about-title">{s.game.about}</h2>
        {intro.map((b) =>
          b.type === 'list' ? <ul>{b.items.map((item) => <li>{item}</li>)}</ul> : <p class="muted">{b.text}</p>
        )}
      </div>
      {sections.length > 0 && (
        <div class="features">
          {sections.map((sec, i) => (
            <div class:list={['feature', { first: i === 0 }]}>
              <h3>{sec.title}</h3>
              {sec.body.map((b) =>
                b.type === 'list' ? <ul class="muted">{b.items.map((item) => <li>{item}</li>)}</ul> : <p class="muted">{b.text}</p>
              )}
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- MORE -->
    {related.length > 0 && (
      <section class="more-band" aria-labelledby="more">
        <div class="container more">
          <div class="more-head">
            <h2 id="more" class="display more-title">{s.game.more[game.category]}</h2>
            <a class="more-all" href={`${home}#games`}>{s.game.backToCatalog}</a>
          </div>
          <ul class="more-grid">
            {related.map((g) => (
              <li>
                <a class="card" href={routes.game(lang, g)}>
                  <img class="card-icon" src={iconUrl(g)} alt="" width="512" height="512" loading="lazy" decoding="async" />
                  <div class="card-body">
                    <span class="card-cat">{categoryLabel[g.category][lang]}</span>
                    <h3 class="card-title">{g.title[lang]}</h3>
                    <p class="card-short">{g.short[lang]}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .head-wrap { padding-top: 40px; padding-bottom: 48px; }
  .crumbs {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 28px;
    font-size: 15px;
    color: var(--fg-2);
  }
  .crumbs a {
    text-decoration: underline;
    text-underline-offset: 3px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .crumbs a:hover { color: var(--fg); }
  .crumbs [aria-current] { color: var(--fg); font-weight: 600; }

  .head { display: flex; flex-wrap: wrap; gap: 32px; align-items: center; }
  .head-icon { width: 148px; height: 148px; border-radius: 32px; flex: none; border: 1px solid var(--line); }
  .head-copy { flex: 999 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    border: 1.5px solid var(--line);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--fg-2);
  }
  .chip-lime { background: var(--lime); border-color: var(--lime); color: var(--on-lime); font-weight: 700; }
  .head-title { font-size: clamp(48px, 8vw, 108px); line-height: .88; overflow-wrap: break-word; }
  .head-short { font-size: 19px; line-height: 1.55; max-width: 640px; }
  .head-cta { flex: 1 1 260px; display: flex; flex-direction: column; gap: 10px; align-items: stretch; }
  .btn-big { min-height: 56px; font-size: 17px; font-weight: 800; white-space: nowrap; }
  .head-note { font-size: 14px; text-align: center; }

  .shots-band { background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .shots-band .container { padding-top: 40px; padding-bottom: 36px; }
  .shots {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 12px;
    scroll-snap-type: x mandatory;
  }
  .shots img {
    height: min(520px, 70vh);
    width: auto;
    flex: none;
    border-radius: 16px;
    border: 1px solid var(--line);
    scroll-snap-align: start;
  }

  .about {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-start;
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .about-intro { flex: 1 1 300px; display: flex; flex-direction: column; gap: 20px; }
  .about-title { font-size: clamp(40px, 5vw, 64px); }
  .about-intro p { font-size: 18px; line-height: 1.65; }
  .features {
    flex: 999 1 560px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 40px;
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 4px solid var(--line);
  }
  .feature.first { border-top-color: var(--fg); }
  .feature h3 { font-size: 19px; font-weight: 700; }
  .feature p, .feature li { font-size: 16px; line-height: 1.6; }
  .feature ul, .about-intro ul { padding-left: 1.2em; display: flex; flex-direction: column; gap: 4px; }
  @media (max-width: 640px) { .features { grid-template-columns: 1fr; } }

  .more-band { background: var(--surface); border-top: 1px solid var(--line); }
  .more { padding-top: 72px; padding-bottom: 88px; }
  .more-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 32px;
  }
  .more-title { font-size: clamp(40px, 5vw, 64px); }
  .more-all {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .more-grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .more-grid .card { height: 100%; }
  @media (max-width: 900px) { .more-grid { grid-template-columns: 1fr; } }
</style>
