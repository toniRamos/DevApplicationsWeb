---
import type { Lang } from '../data/games';
import { EMAIL, PLAY_DEVELOPER_URL, SITE_URL, locales, routes, t } from '../i18n/ui';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this same page in each language, used for canonical and hreflang. */
  alternates: Record<Lang, string>;
  ogImage?: { src: string; width: number; height: number; alt: string };
  ogType?: 'website' | 'article';
  jsonLd: object;
}

const {
  lang,
  title,
  description,
  alternates,
  ogImage = { src: '/images/logoDevApplications.png', width: 1536, height: 1024, alt: 'DevApplications' },
  ogType = 'website',
  jsonLd,
} = Astro.props;

const s = t(lang);
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const abs = (path: string) => `${SITE_URL}${path}`;
const canonical = abs(alternates[lang]);
const home = routes.home(lang);
---

<!doctype html>
<html lang={locales[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Theme before first paint: saved choice, else the system preference -->
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem('devapps-theme'); } catch (e) {}
        if (theme === 'paper') theme = 'light';
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Antonio Ramos – DevApplications" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0F13" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical & hreflang -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={abs(alternates.es)} />
    <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(alternates.es)} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DevApplications" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage.src)} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:locale" content={locales[lang].ogLocale} />
    <meta property="og:locale:alternate" content={locales[otherLang].ogLocale} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage.src)} />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Big+Shoulders+Display:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --f-display: 'Big Shoulders Display', 'Archivo Narrow', sans-serif;
        --f-body: 'Archivo', system-ui, sans-serif;

        /* light (default) */
        --bg: #FFFFFF;
        --surface: #F2F3F6;
        --surface-2: #E8EAEF;
        --card: #FFFFFF;
        --line: #D9DCE3;
        --line-strong: #B9BEC9;
        --fg: #0E0F13;
        --fg-2: #4B5160;
        --btn-bg: #0E0F13;
        --btn-fg: #FFFFFF;
        --shadow: 0 12px 28px rgba(14, 15, 19, .08);
        --logo-plate: #0E0F13;

        /* accent: lime, always as a fill with dark ink on top */
        --lime: #C8FF2E;
        --lime-hover: #B6F000;
        --on-lime: #0E0F13;
        --frame: #0E0F13;

        --max: 1240px;
        --gutter: 24px;
        --radius: 12px;
        --ease: cubic-bezier(.2, .7, .2, 1);
        color-scheme: light;
      }

      :root[data-theme='dark'] {
        --bg: #0E0F13;
        --surface: #17191F;
        --surface-2: #1F222A;
        --card: #17191F;
        --line: #2A2E37;
        --line-strong: #454B58;
        --fg: #F2F3F5;
        --fg-2: #A7ACB8;
        --btn-bg: #F2F3F5;
        --btn-fg: #0E0F13;
        --shadow: 0 12px 28px rgba(0, 0, 0, .45);
        --logo-plate: transparent;
        --frame: #000000;
        color-scheme: dark;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: var(--f-body);
        background: var(--bg);
        color: var(--fg);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        transition: background 200ms var(--ease), color 200ms var(--ease);
      }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }
      button { font: inherit; color: inherit; }
      :focus-visible { outline: 3px solid var(--lime); outline-offset: 2px; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition: none !important; animation: none !important; }
      }

      .container { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }

      .display {
        font-family: var(--f-display);
        font-weight: 900;
        text-transform: uppercase;
        line-height: .9;
        letter-spacing: -.005em;
      }
      .mark {
        background: var(--lime);
        color: var(--on-lime);
        padding: 0 .08em;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
      }
      .muted { color: var(--fg-2); }

      /* buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 52px;
        padding: 0 26px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 16px;
        border: 0;
        cursor: pointer;
        transition: transform 140ms var(--ease), background 140ms var(--ease), color 140ms var(--ease);
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary { background: var(--btn-bg); color: var(--btn-fg); }
      .btn-primary:hover { background: var(--lime); color: var(--on-lime); }
      .btn-lime { background: var(--lime); color: var(--on-lime); }
      .btn-lime:hover { background: var(--lime-hover); }
      .btn-ink { background: #0E0F13; color: #FFFFFF; }
      .btn-ink:hover { background: #2A2E37; }

      .tag-new {
        display: inline-block;
        background: var(--lime);
        color: var(--on-lime);
        font-weight: 800;
        font-size: 11px;
        padding: 2px 7px;
        border-radius: 5px;
        text-transform: uppercase;
        letter-spacing: .04em;
      }

      /* game card (home catalog + related games) */
      .card {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 18px;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        transition: transform 160ms var(--ease), border-color 160ms var(--ease), box-shadow 160ms var(--ease);
      }
      .card:hover { transform: translateY(-3px); border-color: var(--line-strong); box-shadow: var(--shadow); }
      .card-icon { width: 64px; height: 64px; border-radius: 14px; flex: none; }
      .card-body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
      .card-meta { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
      .card-cat {
        color: var(--fg-2);
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
      }
      .card-title { font-size: 18px; font-weight: 700; line-height: 1.25; }
      .card-short { color: var(--fg-2); font-size: 15px; line-height: 1.5; }

      /* header */
      .site-head { border-bottom: 1px solid var(--line); background: var(--bg); }
      .nav {
        max-width: var(--max);
        margin: 0 auto;
        padding: 12px var(--gutter);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 6px 12px;
        margin-left: -12px;
        border-radius: 10px;
        background: var(--logo-plate);
      }
      .brand img { height: 44px; width: auto; }
      .nav-links { display: flex; gap: 28px; }
      .nav-link {
        color: var(--fg-2);
        font-weight: 600;
        font-size: 15px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .nav-link:hover { color: var(--fg); }
      .nav-actions { display: flex; align-items: center; gap: 10px; }
      .theme-toggle {
        width: 44px; height: 44px;
        display: grid; place-items: center;
        border-radius: 999px;
        border: 1.5px solid var(--line);
        background: transparent;
        cursor: pointer;
        color: var(--fg);
      }
      .theme-toggle:hover { border-color: var(--fg); }
      .theme-toggle .icon-sun { display: none; }
      [data-theme='dark'] .theme-toggle .icon-sun { display: block; }
      [data-theme='dark'] .theme-toggle .icon-moon { display: none; }
      .lang {
        display: flex;
        border: 1.5px solid var(--line);
        border-radius: 999px;
        padding: 3px;
      }
      .lang a {
        min-width: 44px;
        min-height: 38px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        color: var(--fg-2);
        font-weight: 700;
        font-size: 13px;
      }
      .lang a[aria-current='page'] { background: var(--btn-bg); color: var(--btn-fg); }
      .lang a:not([aria-current]):hover { color: var(--fg); }
      @media (max-width: 720px) {
        .nav-links { display: none; }
        .brand img { height: 34px; }
      }

      /* footer */
      .site-foot { border-top: 1px solid var(--line); }
      .site-foot-in {
        max-width: var(--max);
        margin: 0 auto;
        padding: 20px var(--gutter);
        display: flex;
        flex-wrap: wrap;
        gap: 8px 32px;
        justify-content: space-between;
        align-items: center;
        color: var(--fg-2);
        font-size: 14px;
      }
      .site-foot-links { display: flex; flex-wrap: wrap; gap: 0 24px; }
      .site-foot-links a { color: var(--fg); min-height: 44px; display: inline-flex; align-items: center; }
      .site-foot-links a:hover { text-decoration: underline; text-underline-offset: 3px; }
    </style>
  </head>
  <body>
    <header class="site-head">
      <nav class="nav" aria-label={s.navLabel}>
        <a href={home} class="brand">
          <img src="/images/brand/logo-nav.webp" alt="DevApplications" width="475" height="120" />
        </a>
        <div class="nav-links">
          <a class="nav-link" href={`${home}#games`}>{s.nav.games}</a>
          <a class="nav-link" href={`${home}#studio`}>{s.nav.studio}</a>
          <a class="nav-link" href={`${home}#contact`}>{s.nav.contact}</a>
        </div>
        <div class="nav-actions">
          <button type="button" class="theme-toggle" id="theme-toggle" aria-label={s.themeToggle} title={s.themeToggle}>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
          </button>
          <div class="lang" role="group" aria-label={s.langLabel}>
            {(['es', 'en'] as Lang[]).map((l) => (
              <a
                href={alternates[l]}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? 'page' : undefined}
                title={l === lang ? undefined : s.switchTo}
              >{l.toUpperCase()}</a>
            ))}
          </div>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="site-foot">
      <div class="site-foot-in">
        <span>© {new Date().getFullYear()} DevApplications · {s.footer.made}</span>
        <div class="site-foot-links">
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <a href={PLAY_DEVELOPER_URL} target="_blank" rel="noreferrer">Google Play</a>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('devapps-theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
